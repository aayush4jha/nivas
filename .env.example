# Supabase — from your project's API settings.
# The app runs entirely without these; the catalogue falls back to the seed data
# in src/data. Set them when you are ready to move state into Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (not yet wired up)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
